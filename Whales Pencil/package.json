{
  "name": "whale-pencil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "神笔鲸良（Whale's Pencil）—— 铺满桌面的透明画布：agent 用任意颜色画，用户从托盘取一支红铅笔，两边都能擦掉对方画的东西。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./pencil.ps1": "./pencil.ps1",
    "./annotate.ps1": "./annotate.ps1",
    "./locate.ps1": "./locate.ps1",
    "./screen.ps1": "./screen.ps1"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "pencil.ps1",
    "annotate.ps1",
    "locate.ps1",
    "screen.ps1",
    "skills/pencil-board.md",
    "skills/pencil-summon.md",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "canvas",
    "drawing",
    "annotation",
    "whale-pencil",
    "神笔鲸良"
  ]
}
